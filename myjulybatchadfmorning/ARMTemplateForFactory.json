						"    iif(isNull(byName('Title')), ' ', toString(byName('Title'))),\" \",\r",
						"    iif(isNull(byName('FirstName')), ' ', toString(byName('FirstName'))),\" \",\r",
						"    iif(isNull(byName('MiddleName')), ' ', toString(byName('MiddleName'))),\" \",\r",
						"    iif(isNull(byName('LastName')), ' ', toString(byName('LastName'))),\" \",\r",
						"    iif(isNull(byName('Suffix')), ' ', toString(byName('Suffix')))\r",
						")) ~> derivedColumn1",
						"RemoveColumns1 select(skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"derivedColumn1 select(mapColumn(",
						"          FullName,",
						"          each(match(name!='NameStyle'&&name!='PasswordHash'&&name!='PasswordSalt'&&name!='rowguid'))",
						"     ),",
						"     skipDuplicateMapInputs: true,",
