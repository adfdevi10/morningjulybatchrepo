					"scriptLines": [
						"source(output(",
						"          CustomerID as integer,",
						"          NameStyle as boolean,",
						"          Title as string,",
						"          FirstName as string,",
						"          MiddleName as string,",
						"          LastName as string,",
						"          Suffix as string,",
						"          CompanyName as string,",
						"          SalesPerson as string,",
						"          EmailAddress as string,",
						"          Phone as string,",
						"          PasswordHash as string,",
						"          PasswordSalt as string,",
						"          rowguid as string,",
						"          ModifiedDate as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"sort1 compose(mapColumn(",
						"          ModifiedDate",
						"     ),",
						"     composition: 'AddDateTime') ~> flowlet1@(output1)",
						"source1 derive(FullName = concat(\r",
						"    iif(isNull(byName('Title')), ' ', toString(byName('Title'))),\" \",\r",
						"    iif(isNull(byName('FirstName')), ' ', toString(byName('FirstName'))),\" \",\r",
						"    iif(isNull(byName('MiddleName')), ' ', toString(byName('MiddleName'))),\" \",\r",
						"    iif(isNull(byName('LastName')), ' ', toString(byName('LastName'))),\" \",\r",
						"    iif(isNull(byName('Suffix')), ' ', toString(byName('Suffix')))\r",
						")) ~> derivedColumn1",
						"RemoveColumns1 select(skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"derivedColumn1 select(mapColumn(",
						"          FullName,",
						"          each(match(name!='NameStyle'&&name!='PasswordHash'&&name!='PasswordSalt'&&name!='rowguid'))",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> RemoveColumns1",
						"select1 sort(asc(CustomerID, false)) ~> sort1",
						"flowlet1@output1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     partitionFileNames:['customer_transformed.csv'],",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
