{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Customer_Source_SQL",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "select1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "RemoveColumns1",
					"description": "Autogenerated by data preview actions"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FullName = concat(\r",
				"    iif(isNull(byName('Title')), ' ', toString(byName('Title'))),\" \",\r",
				"    iif(isNull(byName('FirstName')), ' ', toString(byName('FirstName'))),\" \",\r",
				"    iif(isNull(byName('MiddleName')), ' ', toString(byName('MiddleName'))),\" \",\r",
				"    iif(isNull(byName('LastName')), ' ', toString(byName('LastName'))),\" \",\r",
				"    iif(isNull(byName('Suffix')), ' ', toString(byName('Suffix')))\r",
				")) ~> derivedColumn1",
				"RemoveColumns1 select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sort(asc(ERROR_FUNCTION(''), true)) ~> sort1",
				"derivedColumn1 select(mapColumn(",
				"          FullName,",
				"          each(match(name != 'NameStyle' && name != 'PasswordHash' && name != 'PasswordSalt' && name != 'rowguid'))",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RemoveColumns1"
			]
		}
	}
}